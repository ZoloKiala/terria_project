# Never ship the host's node_modules into the image: the build stage runs its own
# `yarn install`, and native modules built on the host (Windows) are not portable
# to the Linux container.
node_modules
**/node_modules

# Build artifacts are regenerated by `yarn gulp release` inside the build stage.
wwwroot/build
wwwroot/doc
wwwroot/index.html
version.js
version.json

# Local/VCS noise that would bloat the build context and bust the layer cache.
.git
.github
.devcontainer
.husky
doc
architecture
ckanext-cesiumpreview
*.log
npm-debug.log
yarn-error.log
.DS_Store
.idea
.vscode
deploy/packages
deploy/work
