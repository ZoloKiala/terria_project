{
  // Fallback only; Railway's injected $PORT is passed via --port at startup.
  "port": 3001,

  // Railway terminates TLS and reverse-proxies to the container. Trusting the
  // X-Forwarded-* headers makes terriajs-server generate correct https share URLs.
  "trustProxy": true,

  "allowProxyFor": [
    // The IWMI Data Cube explorer API serves GeoJSON without CORS headers, so vector
    // items from it are fetched via this server's /proxy endpoint. Matching is exact
    // hostname or *.domain, so this allows only this one host.
    "explorer-production-0070.up.railway.app",

    "githubusercontent.com",

    // NOTE: The following default entries are deprecated and will be removed in a future release. If you rely ony terria proxying to any of these servers, please add them through a custom serverconfig.json. See https://docs.terria.io/guide/getting-started/#customizing-terriamap
    "nicta.com.au",
    "gov.au",
    "csiro.au",
    "argo.jcommops.org",
    "www.abc.net.au",
    "geoserver.aurin.org.au",
    "mapsengine.google.com",
    "s3-ap-southeast-2.amazonaws.com",
    "adelaidecitycouncil.com",
    "www.dptiapps.com.au",
    "geoserver-123.aodn.org.au",
    "geoserver.imos.org.au",
    "nci.org.au",
    "static.nationalmap.nicta.com.au",
    "gov",
    "gov.uk",
    "gov.nz",
    "services.aremi.data61.io"
  ]
}
